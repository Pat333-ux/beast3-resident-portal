{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://beast3.local/schemas/household-intake.v1.0.0.json","title":"BEAST3HouseholdIntake","type":"object","additionalProperties":false,"required":["schemaVersion","intakeId","idempotencyKey","submittedAt","jurisdiction","householdProfile","requestedTracks"],"properties":{"schemaVersion":{"type":"string","const":"1.0.0"},"intakeId":{"type":"string","minLength":8,"maxLength":128},"idempotencyKey":{"type":"string","minLength":8,"maxLength":128},"submittedAt":{"type":"string","format":"date-time"},"jurisdiction":{"type":"object","additionalProperties":false,"required":["state","county"],"properties":{"state":{"type":"string","minLength":2,"maxLength":32},"county":{"type":"string","minLength":2,"maxLength":64},"municipality":{"type":"string","maxLength":64}}},"householdProfile":{"type":"object","additionalProperties":false,"required":["householdSize","grossMonthlyIncomeCents","liquidAssetsCents"],"properties":{"householdSize":{"type":"integer","minimum":1,"maximum":30},"grossMonthlyIncomeCents":{"type":"integer","minimum":0},"liquidAssetsCents":{"type":"integer","minimum":0},"monthlyUtilityExpenseCents":{"type":"integer","minimum":0},"hasSeniorOrDisability":{"type":"boolean"},"isVeteranHousehold":{"type":"boolean"}}},"requestedTracks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","enum":["SNAP","MEDICAID","LIHEAP","FSSA","VA_RELIEF","IHCDA_HOUSING","CREDIT_REPAIR","HOME_LOAN","EDUCATION_FAFSA","GRANTS","CARE_AUTOMATION"]}},"piiReference":{"type":"object","additionalProperties":false,"required":["scrubbedDigest","vaultRef"],"properties":{"scrubbedDigest":{"type":"string","minLength":16,"maxLength":128},"vaultRef":{"type":"string","minLength":4,"maxLength":128}}}}}