"""
beast3-resident-portal | Unified Front Door for BEAST System 3.0
Single-file FastAPI + HTML5/Tailwind Progressive Resident Portal.
Run: pip install fastapi uvicorn pydantic && uvicorn app:app --reload
"""

import asyncio
import hashlib
import time
from typing import List, Optional
from fastapi import FastAPI
from fastapi.responses import HTMLResponse
from pydantic import BaseModel, Field

app = FastAPI(title="BEAST 3.0 Unified Resident Portal", version="3.0.0")


# ---------------------------------------------------------------------------
# 1. Unified Intake Schema (Aligned with schemas-household-intake.json)
# ---------------------------------------------------------------------------
class HouseholdIntake(BaseModel):
    zip_code: str = Field(..., min_length=5, max_length=10, examples=["47802"])
    household_size: int = Field(..., ge=1, le=15, examples=[3])
    gross_monthly_income: float = Field(..., ge=0, examples=[2400.0])
    monthly_utility_cost: float = Field(default=220.0, ge=0)
    is_veteran: bool = Field(default=False)
    has_credit_challenges: bool = Field(default=False)
    goal_first_home: bool = Field(default=False)


class ProgramRecommendation(BaseModel):
    division: str
    program_name: str
    estimated_monthly_value: float
    estimated_one_time_value: float
    confidence: str
    next_action: str
    tier_required: int


class UnifiedRoadmapResponse(BaseModel):
    intake_hash: str
    total_estimated_monthly_value: float
    total_estimated_one_time_value: float
    recommendations: List[ProgramRecommendation]


# ---------------------------------------------------------------------------
# 2. Parallel Division Evaluators (Civic, Veterans, Credit, Home Loan)
# ---------------------------------------------------------------------------
async def evaluate_civic_aid(intake: HouseholdIntake) -> List[ProgramRecommendation]:
    """Mirrors civic-aid-pipeline (Indiana FSSA: SNAP, Medicaid, LIHEAP)."""
    await asyncio.sleep(0.05)  # Non-blocking division call
    results: List[ProgramRecommendation] = []

    # 2026 Federal Poverty Level (FPL) monthly baseline approximation
    fpl_monthly = 1305 + (intake.household_size - 1) * 460

    # SNAP (130% FPL gross income test in Indiana)
    if intake.gross_monthly_income <= fpl_monthly * 1.30:
        max_snap = 292 + (intake.household_size - 1) * 215
        est_snap = max(50.0, round(max_snap - (intake.gross_monthly_income * 0.24), 2))
        results.append(
            ProgramRecommendation(
                division="civic-aid-pipeline",
                program_name="Indiana FSSA SNAP Food Assistance",
                estimated_monthly_value=est_snap,
                estimated_one_time_value=0.0,
                confidence="High",
                next_action="Verify income & generate pre-filled Indiana FSSA packet",
                tier_required=3,
            )
        )

    # Medicaid / Healthy Indiana Plan (HIP 2.0 - 138% FPL)
    if intake.gross_monthly_income <= fpl_monthly * 1.38:
        results.append(
            ProgramRecommendation(
                division="civic-aid-pipeline",
                program_name="Healthy Indiana Plan (HIP 2.0 / Medicaid)",
                estimated_monthly_value=450.0 * intake.household_size,
                estimated_one_time_value=0.0,
                confidence="High",
                next_action="Confirm household SSNs for instant FSSA submission",
                tier_required=3,
            )
        )

    # LIHEAP Energy Assistance (60% State Median Income proxy)
    if intake.gross_monthly_income <= fpl_monthly * 1.50 and intake.monthly_utility_cost > 0:
        results.append(
            ProgramRecommendation(
                division="civic-aid-pipeline",
                program_name="Indiana EAP / LIHEAP Utility Relief",
                estimated_monthly_value=0.0,
                estimated_one_time_value=525.0,
                confidence="High",
                next_action="Upload latest electric/gas bill for direct vendor credit",
                tier_required=2,
            )
        )

    return results


async def evaluate_veterans_affairs(intake: HouseholdIntake) -> List[ProgramRecommendation]:
    """Mirrors beast3-veterans-affairs."""
    await asyncio.sleep(0.05)
    if not intake.is_veteran:
        return []
    return [
        ProgramRecommendation(
            division="beast3-veterans-affairs",
            program_name="Indiana Military Family Relief Fund (MFRF) & VA Benefits Audit",
            estimated_monthly_value=350.0,
            estimated_one_time_value=1500.0,
            confidence="High",
            next_action="Connect DD-214 & pair with Terre Haute Veteran Peer Navigator",
            tier_required=2,
        )
    ]


async def evaluate_credit_repair(intake: HouseholdIntake) -> List[ProgramRecommendation]:
    """Mirrors credit-repair-orchestrator + LucrDebtSettlement.sol."""
    await asyncio.sleep(0.05)
    if not intake.has_credit_challenges:
        return []
    return [
        ProgramRecommendation(
            division="credit-repair-orchestrator",
            program_name="FCRA Tradeline Audit & LUCR Gasless Debt Settlement",
            estimated_monthly_value=115.0,
            estimated_one_time_value=600.0,
            confidence="Medium",
            next_action="Run soft-pull bureau normalization & check LUCR matching escrow",
            tier_required=3,
        )
    ]


async def evaluate_home_loan(intake: HouseholdIntake) -> List[ProgramRecommendation]:
    """Mirrors home-loan-orchestrator (IHCDA First-Time Homebuyer)."""
    await asyncio.sleep(0.05)
    if not intake.goal_first_home:
        return []
    return [
        ProgramRecommendation(
            division="home-loan-orchestrator",
            program_name="IHCDA First Place Down Payment Assistance (Up to 6%)",
            estimated_monthly_value=0.0,
            estimated_one_time_value=9500.0,
            confidence="Medium",
            next_action="Generate pre-qualification readiness check & MISMO 3.4 profile",
            tier_required=3,
        )
    ]


# ---------------------------------------------------------------------------
# 3. Unified Fan-Out API Gateway Endpoint
# ---------------------------------------------------------------------------
@app.post("/api/evaluate-household", response_model=UnifiedRoadmapResponse)
async def evaluate_household(intake: HouseholdIntake):
    intake_hash = hashlib.sha256(
        f"{intake.model_dump_json()}:{int(time.time() // 3600)}".encode()
    ).hexdigest()[:16]

    civic, vet, credit, home = await asyncio.gather(
        evaluate_civic_aid(intake),
        evaluate_veterans_affairs(intake),
        evaluate_credit_repair(intake),
        evaluate_home_loan(intake),
    )

    all_recs = civic + vet + credit + home
    total_monthly = round(sum(r.estimated_monthly_value for r in all_recs), 2)
    total_onetime = round(sum(r.estimated_one_time_value for r in all_recs), 2)

    return UnifiedRoadmapResponse(
        intake_hash=intake_hash,
        total_estimated_monthly_value=total_monthly,
        total_estimated_one_time_value=total_onetime,
        recommendations=all_recs,
    )


